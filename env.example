# Server
PORT=4000
FRONTEND_URL=http://localhost:3000
OPENDOTA_API_URL=https://api.opendota.com/api
# Optional OpenDota API key. Keep it server-side.
OPENDOTA_API_KEY=

# Gemini is optional; without it the site still shows real OpenDota metrics.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Client-side API base. Empty means same-origin in production.
VITE_API_URL=http://localhost:4000

# Steam OpenID session signing
SESSION_SECRET=replace-with-a-long-random-secret
# Public URL of the API server, used for Steam callback
API_PUBLIC_URL=http://localhost:4000
